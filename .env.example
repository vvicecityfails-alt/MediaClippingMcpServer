# MediaClippingMcpServer Configuration
# Copy to .env and fill in your values

# ============================================
# FFmpeg Configuration (auto-detected if not set)
# ============================================
MEDIA_CLIP_FFMPEG_PATH=
MEDIA_CLIP_FFPROBE_PATH=
MEDIA_CLIP_YT_DLP_PATH=

# ============================================
# Server Configuration
# ============================================
MEDIA_CLIP_OUTPUT_DIR=./output
MEDIA_CLIP_MAX_CONCURRENT=4
MEDIA_CLIP_LOG_LEVEL=INFO

# ============================================
# License Configuration (Pro/Enterprise features)
# ============================================
# RSA Public Key for verifying license signatures (PEM format, multi-line)
# Generate with: python -m media_clipping_mcp.license_gen --generate-keypair
LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
-----END PUBLIC KEY-----"

# Stripe Secret Key for subscription validation (optional)
# Get from: https://dashboard.stripe.com/apikeys
LICENSE_STRIPE_SECRET_KEY=

# Stripe Webhook Secret for verifying webhooks (optional)
# Get from: https://dashboard.stripe.com/webhooks
LICENSE_STRIPE_WEBHOOK_SECRET=

# License file path (alternative to env var)
LICENSE_LICENSE_FILE_PATH=license.json

# License validation cache TTL (seconds)
LICENSE_CACHE_TTL_SECONDS=3600

# ============================================
# Client License Key (for end users)
# ============================================
# Set this environment variable on the client machine
# MEDIA_CLIP_LICENSE_KEY=eyJUaWVyIjoxLCJDdXN0b21lckVtYWlsIjoi...