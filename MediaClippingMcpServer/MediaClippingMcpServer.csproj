<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <PackAsTool>false</PackAsTool>
    <Version>1.0.0</Version>
    <Authors>mukul1603</Authors>
    <Description>MCP Server for video/audio clipping using FFmpeg</Description>
    <PackageTags>mcp;media;ffmpeg;clipping;video;audio</PackageTags>
    <RepositoryUrl>https://github.com/mukul1603/MediaClippingMcpServer</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="0.1.0-preview.5" />
    <PackageReference Include="FFMpegCore" Version="5.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="YoutubeExplode" Version="6.6.3" />
  </ItemGroup>

</Project>